generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                         String               @id @default(cuid())
  name                       String
  email                      String               @unique
  passwordHash               String?              @map("password_hash")
  imageUrl                   String?              @map("image_url")
  passwordTokenHash          String?              @map("password_token_hash")
  passwordTokenType          String?              @map("password_token_type")
  passwordTokenExpiry        DateTime?            @map("password_token_expiry")
  sessionVersion             Int                  @default(0) @map("session_version")
  createdAt                  DateTime             @default(now()) @map("created_at")
  updatedAt                  DateTime             @updatedAt @map("updated_at")
  watchlists                 Watchlist[]
  alerts                     Alert[]
  accounts                   Account[]
  settings                   UserSettings?

  @@map("users")
}

model UserSettings {
  id                           String   @id @default(cuid())
  userId                       String   @unique @map("user_id")
  hasSeenDashboardTutorial     Boolean  @default(false) @map("has_seen_dashboard_tutorial")
  defaultAlertThresholdPercent Decimal  @default(-2.0) @map("default_alert_threshold_percent") @db.Decimal(6, 3)
  createdAt                    DateTime @default(now()) @map("created_at")
  updatedAt                    DateTime @updatedAt @map("updated_at")
  user                         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refreshToken      String? @map("refresh_token")
  accessToken       String? @map("access_token")
  expiresAt         Int?    @map("expires_at")
  tokenType         String? @map("token_type")
  scope             String?
  idToken           String? @map("id_token")
  sessionState      String? @map("session_state")
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Coin {
  id             String              @id @default(cuid())
  providerId     String              @unique @map("provider_id")
  symbol         String
  name           String
  imageUrl       String?             @map("image_url")
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")
  priceSnapshots CoinPriceSnapshot[]
  watchlists     Watchlist[]
  alerts         Alert[]

  @@map("coins")
}

model CoinPriceSnapshot {
  id                       String   @id @default(cuid())
  coinId                   String   @map("coin_id")
  priceUsd                 Decimal  @map("price_usd") @db.Decimal(24, 8)
  marketCapUsd             Decimal? @map("market_cap_usd") @db.Decimal(32, 2)
  volumeUsd                Decimal? @map("volume_usd") @db.Decimal(32, 2)
  priceChangePercentage24h Decimal? @map("price_change_percentage_24h") @db.Decimal(12, 6)
  recordedAt               DateTime @default(now()) @map("recorded_at")
  coin                     Coin     @relation(fields: [coinId], references: [id], onDelete: Cascade)

  @@index([coinId, recordedAt])
  @@map("coin_price_snapshots")
}

model Watchlist {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  coinId    String   @map("coin_id")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  coin      Coin     @relation(fields: [coinId], references: [id], onDelete: Cascade)

  @@unique([userId, coinId])
  @@index([coinId])
  @@map("watchlists")
}

model Alert {
  id                String         @id @default(cuid())
  userId            String         @map("user_id")
  coinId            String         @map("coin_id")
  condition         AlertCondition
  thresholdPriceUsd Decimal        @map("threshold_price_usd") @db.Decimal(24, 8)
  status            AlertStatus    @default(ACTIVE)
  triggeredAt       DateTime?      @map("triggered_at")
  triggeredPriceUsd Decimal?       @map("triggered_price_usd") @db.Decimal(24, 8)
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")
  user              User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  coin              Coin           @relation(fields: [coinId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([coinId, status])
  @@map("alerts")
}

enum AlertCondition {
  PRICE_ABOVE
  PRICE_BELOW
}

enum AlertStatus {
  ACTIVE
  TRIGGERED
  PAUSED
}
